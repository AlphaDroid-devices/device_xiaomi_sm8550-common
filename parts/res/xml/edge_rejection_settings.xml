<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/edge_rejection_title">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="edge_rejection_status"
        android:title="@string/edge_rejection_title"
        android:summary="@string/edge_rejection_summary"
        android:defaultValue="true" />

    <org.lineageos.settings.CustomSeekBarPreference
        android:key="edge_deadzone_width"
        android:title="@string/edge_deadzone_title"
        android:summary="@string/edge_deadzone_summary"
        android:max="150"
        android:min="0"
        settings:interval="5"
        settings:units="px"
        android:defaultValue="0" />

</PreferenceScreen>